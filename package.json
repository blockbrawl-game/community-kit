{
  "name": "@blockbrawl-game/community-kit",
  "version": "0.4.1",
  "description": "SDK and dev kit for BlockBrawl community game modes: mode SDK, dev kit (build, test, dev server), sandbox runtime prelude and play-page shell, with example modes.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "brawl-modes": "devkit/cli.js"
  },
  "files": [
    "devkit/",
    "sdk/",
    "runtime/",
    "shell/",
    "modes/",
    "docs/",
    "README.md",
    "LICENSE",
    "npm-shrinkwrap.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/blockbrawl-game/community-kit.git"
  },
  "scripts": {
    "test": "node scripts/check-modes.mjs",
    "dev": "node devkit/cli.js dev",
    "build": "node devkit/cli.js build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@microsoft/signalr": "^11.0.0",
    "esbuild": "^0.28.2"
  }
}
