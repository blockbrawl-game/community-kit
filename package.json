{
  "name": "@blockbrawl-game/community-kit",
  "version": "0.7.0",
  "description": "SDK and dev kit for BlockBrawl community game modes: mode SDK, dev kit (build, test, dev server), sandbox runtime prelude and play-page shell, with example modes.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "brawl-modes": "devkit/cli.js"
  },
  "files": [
    "devkit/",
    "sdk/",
    "runtime/",
    "shell/",
    "modes/",
    "templates/",
    "schema/",
    "docs/",
    "AGENTS.md",
    "CLAUDE.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "npm-shrinkwrap.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/blockbrawl-game/community-kit.git"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\" && node scripts/check-modes.mjs --baseline",
    "dev": "node devkit/cli.js dev",
    "build": "node devkit/cli.js build",
    "check": "node devkit/cli.js check",
    "bench": "node devkit/cli.js bench",
    "new": "node devkit/cli.js new"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@microsoft/signalr": "^11.0.0",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2"
  }
}
